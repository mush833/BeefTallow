<!--
  SHOPIFY PAGE MAPPING: sections/home-final-cta.liquid
  Renders on: HOME PAGE (templates/index.json)
  Purpose: Closing dark CTA band — price, guarantee, button to product page
-->

<section class="final-cta" style="background: {{ section.settings.bg_color | default: '#20140C' }};">
  <div class="final-cta__inner">
    <p class="overline" style="color: var(--gold2);">{{ section.settings.eyebrow | default: 'Early Black Friday · 40% Off' }}</p>
    <h2 class="final-cta__title">{{ section.settings.heading | default: 'One Jar. Ten Seconds. Done.' }}</h2>
    <p class="final-cta__body">{{ section.settings.body | default: 'Stop dodging the mirror. Stop borrowing her moisturizer. Start the one habit that actually sticks.' }}</p>

    <div class="final-cta__price">
      <span class="final-cta__price-now">${{ section.settings.price | default: '34' }}</span>
      <span class="final-cta__price-was">${{ section.settings.compare_price | default: '49' }}</span>
      <span class="final-cta__price-badge">{{ section.settings.discount | default: '40% OFF' }}</span>
    </div>

    <a href="{{ section.settings.cta_url | default: '/products/face-ritual-tallow-balm' }}" class="btn btn-gold btn-lg">
      {{ section.settings.cta_text | default: 'Claim My Jar →' }}
    </a>

    <div class="final-cta__trust">
      <span>✓ 60-Day Money-Back Guarantee</span>
      <span>✓ Free Shipping Over $45</span>
      <span>✓ 2,140+ Verified Buyers</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home — Final CTA",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#20140C" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Early Black Friday · 40% Off" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One Jar. Ten Seconds. Done." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Stop dodging the mirror. Stop borrowing her moisturizer. Start the one habit that actually sticks." },
    { "type": "text", "id": "price", "label": "Price", "default": "34" },
    { "type": "text", "id": "compare_price", "label": "Compare-at price", "default": "49" },
    { "type": "text", "id": "discount", "label": "Discount badge", "default": "40% OFF" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Claim My Jar →" },
    { "type": "url", "id": "cta_url", "label": "Button URL" }
  ],
  "presets": [ { "name": "Home — Final CTA" } ]
}
{% endschema %}
