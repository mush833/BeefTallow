<!--
  SHOPIFY PAGE MAPPING: sections/main-collection.liquid
  Renders on: COLLECTION PAGE (templates/collection.json)
  Purpose: Product grid for a collection. Loops over collection.products.
-->

<section class="collection-page">
  <div class="collection-page__header">
    <h1 class="h2">{{ collection.title | default: 'Shop' }}</h1>
    {% if collection.description != blank %}
      <div class="collection-page__desc">{{ collection.description }}</div>
    {% endif %}
  </div>

  {% if collection.products.size > 0 %}
    <div class="product-grid">
      {% for product in collection.products %}
        <a href="{{ product.url }}" class="product-card">
          <div class="product-card__img">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title | escape }}" loading="lazy" width="250" height="250">
            {% endif %}
            {% if product.compare_at_price > product.price %}
              <span class="product-card__badge">Sale</span>
            {% endif %}
          </div>
          <div class="product-card__info">
            <h3 class="product-card__title">{{ product.title }}</h3>
            <div class="stars" style="font-size:0.8rem;">★★★★★ <span class="count">4.8</span></div>
            <div class="product-card__price">
              <span class="product-card__price-now">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="product-card__price-was">{{ product.compare_at_price | money }}</span>
              {% endif %}
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <p class="collection-empty">No products in this collection yet.</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [],
  "presets": [ { "name": "Collection" } ]
}
{% endschema %}
