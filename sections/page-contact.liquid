<!--
  SHOPIFY PAGE MAPPING: sections/page-contact.liquid
  Renders on: CONTACT PAGE (templates/page.contact.json)
  Purpose: Shopify contact form (form 'contact') — name, email, message. Posts to Shopify's contact endpoint.
-->

<section class="static-page static-page--narrow">
  <div class="static-page__inner">
    <h1 class="h2">{{ section.settings.heading | default: 'Talk To A Human' }}</h1>
    <p class="static-page__lead">{{ section.settings.body | default: 'Question about your order, your skin, or the guarantee? We answer every email ourselves, usually within a day.' }}</p>

    {% form 'contact' %}
      {% if form.posted_successfully? %}
        <div class="form-success">✓ Thanks — we got it. We'll reply to your email shortly.</div>
      {% endif %}
      {% if form.errors %}
        <div class="form-error">Please check the highlighted fields and try again.</div>
      {% endif %}

      <div class="contact-form">
        <label>
          <span>Name</span>
          <input type="text" name="contact[name]" value="{% if form.name %}{{ form.name }}{% endif %}" required>
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% endif %}" required>
        </label>
        <label>
          <span>Order number (optional)</span>
          <input type="text" name="contact[order]">
        </label>
        <label>
          <span>Message</span>
          <textarea name="contact[body]" rows="5" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </label>
        <button type="submit" class="btn btn-primary btn-lg">Send Message →</button>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk To A Human" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Question about your order, your skin, or the guarantee? We answer every email ourselves, usually within a day." }
  ],
  "presets": [ { "name": "Contact" } ]
}
{% endschema %}
