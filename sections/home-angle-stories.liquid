<!--
  SHOPIFY PAGE MAPPING: sections/home-angle-stories.liquid
  Renders on: HOME PAGE ONLY (templates/index.json)
  Purpose: Three emotional angle story sections
    1. The Stool by the Sink (dad angle)
    2. Behind the Camera (photo angle)
    3. Her Shelf / One Jar (routine angle)
  Each alternates image left/right on desktop
-->

{% for block in section.blocks %}
  <section class="angle-section{% cycle '', ' section--cream' %}" {{ block.shopify_attributes }}>
    <div class="angle-section__inner{% cycle '', ' reversed' %}">
      <!-- Image -->
      <div class="angle-section__img">
        {% if block.settings.image %}
          <img src="{{ block.settings.image | image_url: width: 800 }}"
               alt="{{ block.settings.image.alt | default: block.settings.heading }}"
               loading="lazy"
               width="600" height="750">
        {% else %}
          <div style="width:100%;height:100%;background:var(--bg3);display:flex;align-items:center;justify-content:center;color:var(--gold);font-family:var(--serif);padding:40px;text-align:center;">{{ block.settings.heading }}</div>
        {% endif %}
      </div>

      <!-- Copy -->
      <div class="angle-section__copy">
        <p class="overline">{{ block.settings.eyebrow }}</p>
        <h2>{{ block.settings.heading }}</h2>
        <p>{{ block.settings.body }}</p>
        <a href="/products/face-ritual-tallow-balm" class="btn btn-primary">{{ block.settings.cta | default: 'Shop Now' }}</a>
      </div>
    </div>
  </section>
{% endfor %}

{% schema %}
{
  "name": "Home — Angle Stories",
  "blocks": [
    {
      "type": "angle",
      "name": "Story Angle",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow label",
          "default": "The Stool By The Sink"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "You used to be that kid."
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body copy",
          "default": "You used to stand on a stool and watch your dad get ready — the soap, the splash of water, the way he carried himself out the door. Now there's a stool next to your sink, and someone small is standing on it, watching you.\n\nOne morning they'll catch themselves and realize they became the man they looked up to. Give them something worth copying."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Section image"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "CTA text",
          "default": "Get Vallore™"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home — Angle Stories",
      "blocks": [
        {
          "type": "angle",
          "settings": {
            "eyebrow": "The Stool By The Sink",
            "heading": "You used to be that kid.",
            "body": "You used to stand on a stool and watch your dad get ready — the soap, the splash of water, the way he carried himself out the door. Now there's a stool next to your sink, and someone small is standing on it, watching you.\n\nOne morning they'll catch themselves and realize they became the man they looked up to. Give them something worth copying."
          }
        },
        {
          "type": "angle",
          "settings": {
            "eyebrow": "Behind The Camera",
            "heading": "You're always the one taking the picture.",
            "body": "You're the guy who grabs everyone's phone so the shot comes out right. Years of birthdays, trips and ordinary Sundays — and you're in almost none of them.\n\nSome of that is being the dependable one. Some of it is not loving how you've looked lately. Ten seconds a day handles the second part — so you stop staying behind the camera."
          }
        },
        {
          "type": "angle",
          "settings": {
            "eyebrow": "The Morning Routine",
            "heading": "Her shelf. Your one jar.",
            "body": "Your wife has a whole shelf — cleanser, serum, eye cream, the works. You looked at all those bottles and thought, \"yeah, I'm never doing that,\" and walked out the door with dry skin instead.\n\nOne jar by the sink. Ten seconds. Done before she can ask \"you're done already?\" A routine you'll actually keep, because it isn't one."
          }
        }
      ]
    }
  ]
}
{% endschema %}
