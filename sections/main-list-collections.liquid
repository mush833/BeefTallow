<!--
  SHOPIFY PAGE MAPPING: sections/main-list-collections.liquid
  Renders on: COLLECTIONS LIST PAGE (templates/list-collections.json) — the "Collections list" item in the theme nav
  Purpose: Grid of all store collections.
-->

<section class="collection-page">
  <div class="collection-page__header">
    <h1 class="h2">{{ section.settings.heading | default: 'Collections' }}</h1>
  </div>
  <div class="product-grid">
    {% for collection in collections %}
      <a href="{{ collection.url }}" class="product-card">
        <div class="product-card__img">
          {% if collection.featured_image %}
            <img src="{{ collection.featured_image | image_url: width: 500 }}" alt="{{ collection.title | escape }}" loading="lazy" width="250" height="250">
          {% endif %}
        </div>
        <div class="product-card__info">
          <h3 class="product-card__title">{{ collection.title }}</h3>
          <span class="count">{{ collection.products_count }} products</span>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }
  ],
  "presets": [ { "name": "Collections list" } ]
}
{% endschema %}
