<!--
  SHOPIFY PAGE MAPPING: sections/home-hero.liquid
  Renders on: HOME PAGE ONLY (templates/index.json)
  Purpose: Homepage hero — mobile stacked layout and desktop two-col layout
  Copy from site: "One jar. Ten seconds. Skin that looks rested."
  Mobile: product image on top, copy below
  Desktop: copy left, product image right
-->

<section class="hero">

  <!-- MOBILE HERO (shown on screens < 768px) -->
  <div class="hero-mobile">
    <p class="hero-eyebrow">{{ section.settings.eyebrow | default: 'Beef Tallow · For Men' }}</p>
    <h1 class="hero-title">{{ section.settings.heading | default: 'One jar. Ten seconds. Skin that looks rested.' }}</h1>
    <p class="hero-subtitle">{{ section.settings.subheading | default: 'No routine. No shine. No sting.' }}</p>

    <div class="rating-row" style="justify-content:center; margin-top:8px;">
      <span class="stars">★★★★★</span>
      <span style="font-weight:600; font-size:0.9rem;">4.8</span>
      <span class="count">· 2,140+ reviews</span>
    </div>

    <div class="hero-mobile__img">
      {% if section.settings.hero_image %}
        <img src="{{ section.settings.hero_image | image_url: width: 800 }}"
             alt="{{ section.settings.hero_image.alt | default: 'Vallore Tallow Balm' }}"
             loading="eager"
             width="800" height="800">
      {% elsif product %}
        <img src="{{ product.featured_image | image_url: width: 800 }}"
             alt="{{ product.title }}"
             loading="eager"
             width="800" height="800">
      {% else %}
        <div style="width:100%;height:100%;background:var(--bg3);display:flex;align-items:center;justify-content:center;color:var(--gold);font-family:var(--serif);font-size:1.2rem;">Vallore™</div>
      {% endif %}
    </div>

    <div style="padding:28px 0 32px; display:flex; flex-direction:column; gap:16px; width:100%;">
      <div class="hero-price-row">
        <span class="price">$34.00</span>
        <span class="price-compare">$49.00</span>
        <span class="price-badge">40% OFF</span>
      </div>

      <a href="/products/face-ritual-tallow-balm" class="btn btn-primary btn-lg btn-full">
        {{ section.settings.cta_text | default: 'Shop Now' }}
      </a>

      <div class="hero-benerow">
        <div class="hero-bene"><b>60-Day</b><span>Guarantee</span></div>
        <div class="hero-bene"><b>Free Ship</b><span>Over $45</span></div>
        <div class="hero-bene"><b>4 Real</b><span>Ingredients</span></div>
      </div>

      <p class="hero-micro">Ships in 24–48 hrs · Early Black Friday pricing</p>
    </div>
  </div>

  <!-- DESKTOP HERO (shown on screens > 768px) -->
  <div class="hero-desktop">
    <div class="hero-desktop__copy">
      <p class="hero-eyebrow">{{ section.settings.eyebrow | default: 'Beef Tallow · For Men' }}</p>

      <h1 class="hero-title">{{ section.settings.heading | default: 'One jar. Ten seconds. Skin that looks rested.' }}</h1>

      <p class="lead" style="opacity:0.75;">{{ section.settings.body | default: "Vallore™ is whipped grass-fed beef tallow made for men. Rub a little in after you wash — it sinks in fast, calms razor burn and keeps you comfortable all day." }}</p>

      <div class="rating-row">
        <span class="stars stars-lg">★★★★★</span>
        <span style="font-weight:700;">4.8</span>
        <span class="count">· 2,140+ reviews</span>
      </div>

      <div class="hero-price-row">
        <span class="price">$34.00</span>
        <span class="price-compare">$49.00</span>
        <span class="price-badge">40% OFF</span>
      </div>

      <div class="hero-cta-wrap">
        <a href="/products/face-ritual-tallow-balm" class="btn btn-primary btn-lg">
          {{ section.settings.cta_text | default: 'Shop Now' }}
        </a>
        <p class="hero-micro">Ships in 24–48 hrs · Early Black Friday pricing</p>
      </div>

      <div class="hero-benerow">
        <div class="hero-bene">
          <b>60-Day Guarantee</b>
          <span>Love it or your money back</span>
        </div>
        <div class="hero-bene">
          <b>Free Shipping Over $45</b>
          <span>Ships in 24–48 hours</span>
        </div>
        <div class="hero-bene">
          <b>4 Real Ingredients</b>
          <span>Nothing synthetic</span>
        </div>
      </div>
    </div>

    <div class="hero-desktop__img">
      {% if section.settings.hero_image %}
        <img src="{{ section.settings.hero_image | image_url: width: 1000 }}"
             alt="{{ section.settings.hero_image.alt | default: 'Vallore Tallow Balm' }}"
             loading="eager"
             width="600" height="750">
      {% elsif product %}
        <img src="{{ product.featured_image | image_url: width: 1000 }}"
             alt="{{ product.title }}"
             loading="eager"
             width="600" height="750">
      {% else %}
        <div style="width:100%;height:70vh;background:var(--bg3);border-radius:20px 20px 0 0;display:flex;align-items:center;justify-content:center;color:var(--gold);font-family:var(--serif);font-size:2rem;">Vallore™</div>
      {% endif %}
    </div>
  </div>

</section>

{% schema %}
{
  "name": "Home Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Beef Tallow · For Men"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One jar. Ten seconds. Skin that looks rested."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (mobile)",
      "default": "No routine. No shine. No sting."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy (desktop)",
      "default": "<p>Vallore™ is whipped grass-fed beef tallow made for men. Rub a little in after you wash — it sinks in fast, calms razor burn and keeps you comfortable all day.</p>"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero product image"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA button URL"
    }
  ],
  "presets": [
    {
      "name": "Home Hero"
    }
  ]
}
{% endschema %}
