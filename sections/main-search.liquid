<!--
  SHOPIFY PAGE MAPPING: sections/main-search.liquid
  Renders on: SEARCH PAGE (templates/search.json)
  Purpose: Search form + results listing. Uses the search object.
-->

<section class="search-page">
  <div class="search-page__inner">
    <h1 class="h2">{{ section.settings.heading | default: 'Search' }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search the store…" aria-label="Search">
      <button type="submit" class="btn btn-primary">Search</button>
    </form>

    {% if search.performed %}
      {% if search.results_count > 0 %}
        <p class="search-page__count">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for "{{ search.terms }}"</p>
        <div class="product-grid">
          {% for item in search.results %}
            <a href="{{ item.url }}" class="product-card">
              <div class="product-card__img">
                {% if item.featured_image %}
                  <img src="{{ item.featured_image | image_url: width: 400 }}" alt="{{ item.title | escape }}" loading="lazy" width="200" height="200">
                {% endif %}
              </div>
              <div class="product-card__info">
                <h3 class="product-card__title">{{ item.title }}</h3>
                {% if item.object_type == 'product' %}
                  <div class="product-card__price"><span class="product-card__price-now">{{ item.price | money }}</span></div>
                {% endif %}
              </div>
            </a>
          {% endfor %}
        </div>
      {% else %}
        <p class="search-page__empty">No results for "{{ search.terms }}". Try another word.</p>
      {% endif %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Search",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Search" }
  ],
  "presets": [ { "name": "Search" } ]
}
{% endschema %}
