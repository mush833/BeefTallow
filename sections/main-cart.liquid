<!--
  SHOPIFY PAGE MAPPING: sections/main-cart.liquid
  Renders on: CART PAGE (templates/cart.json)
  Purpose: Full cart — line items, quantity controls, subtotal, checkout button, free-shipping bar.
-->

<section class="cart-page">
  <div class="cart-page__inner">
    <h1 class="h2">{{ section.settings.heading | default: 'Your Cart' }}</h1>

    {% if cart.item_count > 0 %}
      {% assign threshold = section.settings.free_ship_threshold | default: 45 | times: 100 %}
      {% if cart.total_price < threshold %}
        {% assign remaining = threshold | minus: cart.total_price %}
        <div class="cart-shipbar">
          🚚 You're <strong>{{ remaining | money }}</strong> away from <strong>free shipping</strong>.
        </div>
      {% else %}
        <div class="cart-shipbar cart-shipbar--won">✓ You've unlocked <strong>free shipping</strong>.</div>
      {% endif %}

      <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-form">
        <div class="cart-items">
          {% for item in cart.items %}
            <div class="cart-item" data-key="{{ item.key }}">
              <a href="{{ item.url }}" class="cart-item__img">
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="80" height="80">
                {% endif %}
              </a>
              <div class="cart-item__info">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                {% unless item.variant.title contains 'Default' %}
                  <span class="cart-item__variant">{{ item.variant.title }}</span>
                {% endunless %}
                <span class="cart-item__price">{{ item.final_price | money }}</span>
              </div>
              <div class="cart-item__qty">
                <div class="qty-selector">
                  <a href="{{ item.url_to_remove }}" class="qty-selector__btn" aria-label="Decrease">−</a>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity" class="qty-selector__input">
                  <a href="{{ item.url }}" class="qty-selector__btn" aria-label="Increase">+</a>
                </div>
                <a href="{{ item.url_to_remove }}" class="cart-item__remove">Remove</a>
              </div>
              <div class="cart-item__line">{{ item.final_line_price | money }}</div>
            </div>
          {% endfor %}
        </div>

        <div class="cart-summary">
          <div class="cart-summary__row">
            <span>Subtotal</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>
          <p class="cart-summary__note">Shipping &amp; taxes calculated at checkout.</p>
          <button type="submit" name="checkout" class="btn btn-primary btn-lg btn-full">Checkout →</button>
          <button type="submit" name="update" class="cart-summary__update">Update cart</button>
        </div>
      </form>
    {% else %}
      <div class="cart-empty">
        <p>Your cart is empty.</p>
        <a href="/products/face-ritual-tallow-balm" class="btn btn-primary btn-lg">Shop The Face Balm →</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Cart" },
    { "type": "number", "id": "free_ship_threshold", "label": "Free shipping threshold ($)", "default": 45 }
  ],
  "presets": [ { "name": "Cart" } ]
}
{% endschema %}
