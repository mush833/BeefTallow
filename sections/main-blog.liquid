<!--
  SHOPIFY PAGE MAPPING: sections/main-blog.liquid
  Renders on: BLOG PAGE (templates/blog.json) — the "Blogs" item in the theme nav
  Purpose: Lists all articles in a blog. Loops over blog.articles.
-->

<section class="blog-page">
  <div class="blog-page__header">
    <h1 class="h2">{{ blog.title | default: 'The Journal' }}</h1>
  </div>
  <div class="blog-grid">
    {% for article in blog.articles %}
      <a href="{{ article.url }}" class="blog-card">
        <div class="blog-card__img">
          {% if article.image %}
            <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title | escape }}" loading="lazy" width="300" height="200">
          {% endif %}
        </div>
        <div class="blog-card__info">
          <h2 class="blog-card__title">{{ article.title }}</h2>
          <p class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
          <span class="blog-card__date">{{ article.published_at | date: '%b %d, %Y' }}</span>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": [],
  "presets": [ { "name": "Blog" } ]
}
{% endschema %}
