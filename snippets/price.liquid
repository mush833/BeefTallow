{%- comment -%}
  SHOPIFY SNIPPET: snippets/price.liquid
  Reusable price display with compare-at strikethrough + discount badge.
  Usage: {% render 'price', price: product.price, compare: product.compare_at_price %}
{%- endcomment -%}
<span class="price">
  <span class="price__now">{{ price | money_without_trailing_zeros }}</span>
  {%- if compare and compare > price -%}
    <span class="price__was">{{ compare | money_without_trailing_zeros }}</span>
    {%- assign pct = compare | minus: price | times: 100.0 | divided_by: compare | round -%}
    <span class="price__badge">{{ pct }}% OFF</span>
  {%- endif -%}
</span>
