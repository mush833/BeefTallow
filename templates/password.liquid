{%- comment -%}
  SHOPIFY PAGE MAPPING: templates/password.liquid -> PASSWORD / "coming soon" page.
  Rendered inside layout/password.liquid (not the main theme layout).
{%- endcomment -%}

<div class="password-page">
  <div class="password-page__inner">
    <div class="password-page__logo">{{ shop.name }}</div>
    <h1 class="password-page__title">Something Good Is Brewing.</h1>
    <p class="password-page__sub">One jar. Four ingredients. Ten-second ritual. Enter the password to take a look.</p>

    {% form 'storefront_password' %}
      {% if form.errors %}
        <div class="form-error">Wrong password — try again.</div>
      {% endif %}
      <div class="password-form">
        <input type="password" name="password" placeholder="Password" aria-label="Password" required>
        <button type="submit" class="btn btn-primary btn-lg">Enter →</button>
      </div>
    {% endform %}

    <p class="password-page__share">Are you the store owner? <a href="/admin">Log in here</a>.</p>
  </div>
</div>
