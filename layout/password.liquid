<!doctype html>
{%- comment -%}
  SHOPIFY PAGE MAPPING: layout/password.liquid -> wrapper layout for the PASSWORD page only.
  Shopify uses this instead of layout/theme.liquid while the store is password-protected.
{%- endcomment -%}
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body class="template-password">
  {{ content_for_layout }}
</body>
</html>
